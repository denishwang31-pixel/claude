rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- 전역 헬퍼 ---------- */
    function signedIn() { return request.auth != null; }

    function isClubMember(clubId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid));
    }
    function clubRole(clubId) {
      return get(/databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid)).data.role;
    }
    /** 운영 권한 = 회장·총무·운영진·리드
        ('책임리더'는 예전 이름 — 기존 데이터 호환을 위해 리드와 같게 인정한다.
         src/lib/constants.js 의 STAFF_ROLES 와 반드시 같아야 한다) */
    function isClubAdmin(clubId) {
      return (isClubMember(clubId) && (
        clubRole(clubId) == '회장' || clubRole(clubId) == '총무' ||
        clubRole(clubId) == '운영진' || clubRole(clubId) == '리드' ||
        clubRole(clubId) == '책임리더'
      )) || isClubOwner(clubId);
    }
    /** 회비·지출을 다룰 수 있는 역할 = 회장·총무 (constants.js canSeeFees 와 동일) */
    function canSeeFees(clubId) {
      return (isClubMember(clubId) && (
        clubRole(clubId) == '회장' || clubRole(clubId) == '총무'
      )) || isClubOwner(clubId);
    }
    /** 클럽을 만든 사람 — 저장된 역할과 무관하게 회장으로 인정한다.
        (예전 버전은 생성자에게 '총무'를 줬다. 그러면 회장이 아무도 없는데
         임명은 회장만 가능해 아무도 회장이 될 수 없는 교착이 생긴다) */
    function isClubOwner(clubId) {
      return signedIn() &&
        get(/databases/$(database)/documents/clubs/$(clubId)).data.get('ownerId', '') == request.auth.uid;
    }
    /** 역할 임명 권한은 회장(또는 클럽 소유자)만 */
    function isPresident(clubId) {
      return (isClubMember(clubId) && clubRole(clubId) == '회장') || isClubOwner(clubId);
    }
    /** 회장이 아니어도 정할 수 있는 일상 역할 (constants.js DAILY_ROLES 와 동일) */
    function isDailyRole(r) {
      return r == '운영진' || r == '리드' || r == '회원' || r == '책임리더';
    }
    /** 앱 운영자 = appAdmins/{uid} 문서가 존재하는 계정 (Firebase 콘솔에서 수동 등록) */
    function isAppAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/appAdmins/$(request.auth.uid));
    }

    /* ---------- 사용자 라우팅/프로필 ---------- */
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    /* ---------- 초대코드(루트, FIX-04) ----------
       - 로그인 사용자는 조회 가능(가입 시 코드→clubId 확인). 코드를 알아야 문서 특정 가능.
       - 생성/삭제는 해당 클럽 총무. (createClub 트랜잭션 시점엔 owner 멤버가 이미 존재) */
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && isClubAdmin(request.resource.data.clubId);
      allow delete: if signedIn() && isClubAdmin(resource.data.clubId);
      allow update: if false;
    }

    /* ---------- 클럽 ---------- */
    match /clubs/{clubId} {
      allow read: if isClubMember(clubId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isClubAdmin(clubId);

      /* 회원: 읽기 멤버 전체 / 생성은 (지정 오너 자기자신) or (유효 초대코드 자기가입) or 총무 */
      match /members/{memberId} {
        allow read: if isClubMember(clubId);
        allow create: if (request.auth.uid == memberId && (
                          get(/databases/$(database)/documents/clubs/$(clubId)).data.ownerId == request.auth.uid ||
                          (
                            'joinCode' in request.resource.data &&
                            exists(/databases/$(database)/documents/inviteCodes/$(request.resource.data.joinCode)) &&
                            get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.joinCode)).data.clubId == clubId
                          )
                        ))
                        || isClubAdmin(clubId);
        // 본인/운영진은 자유 수정. 그 외 회원은 "그 사람에 대한 내 NTRP 투표"만 가능
        // role 필드를 바꾸려면 회장이어야 함
        // 구력 확인제도: startedAt 은 한 번 기록되면 회장만 바꿀 수 있다
        //   (비어 있을 때 처음 넣는 것은 본인/운영진 모두 가능)
        allow update: if (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['startedAt'])
            || resource.data.get('startedAt', '') == ''
            || isPresident(clubId)
          ) && (
          /* 역할 변경 —
               회장: 전부
               운영 담당: 운영진·리드·회원 사이에서만. 회장·총무는 못 세우고,
                          회장·총무인 사람을 끌어내리지도 못한다.

             역할은 겸임될 수 있어서 roles(배열)와 role(대표) 두 필드로
             저장된다. role 만 막으면 roles 에 '회장'을 몰래 넣어 화면상
             권한을 얻을 수 있으므로 두 필드를 같이 막는다.
             roles 의 내용까지 규칙에서 훑을 수는 없으므로(배열 순회 불가),
             운영 담당이 roles 를 건드리는 것 자체를 회장에게만 허용한다. */
          (isClubAdmin(clubId)
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'roles'])
                  || isPresident(clubId)
                  || (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['roles'])
                      && isDailyRole(request.resource.data.role)
                      && isDailyRole(resource.data.get('role', '회원')))))
          || (request.auth.uid == memberId
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'roles']))
          || (
            isClubMember(clubId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ntrpVotes'])
            && request.resource.data.ntrpVotes.diff(
                 resource.data.get('ntrpVotes', {})
               ).affectedKeys().hasOnly([request.auth.uid])
          ));
        allow delete: if isClubAdmin(clubId);
      }

      /* 가입 신청: 아직 회원이 아닌 사람이 직접 만든다.
         - 생성: 본인 uid 문서만, 반드시 pending 상태로. (역할 지정 불가)
         - 조회: 본인 것 또는 운영진. 목록 열람은 운영진만.
         - 승인/거절(update)·정리(delete): 운영진. 신청 취소는 본인도 가능. */
      match /joinRequests/{applicantUid} {
        allow get: if signedIn() && (request.auth.uid == applicantUid || isClubAdmin(clubId));
        allow list: if isClubAdmin(clubId);
        allow create: if signedIn()
          && request.auth.uid == applicantUid
          && request.resource.data.status == 'pending'
          && !request.resource.data.keys().hasAny(['role']);
        allow update: if isClubAdmin(clubId);
        allow delete: if isClubAdmin(clubId) || request.auth.uid == applicantUid;
      }

      /* 참가투표: 개설·마감·삭제는 운영진. 회원은 자기 표(votes.{uid})만 바꾼다. */
      match /polls/{pollId} {
        allow read: if isClubMember(clubId);
        allow create, delete: if isClubAdmin(clubId);
        allow update: if isClubAdmin(clubId) || (
          isClubMember(clubId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']) &&
          request.resource.data.votes.diff(resource.data.get('votes', {}))
            .affectedKeys().hasOnly([request.auth.uid]) &&
          resource.data.get('closed', false) == false
        );
      }

      /* 채팅: 회원이면 읽기·쓰기. 수정은 막고(내용 바꿔치기 방지),
         삭제는 본인 글 또는 운영진. */
      match /messages/{messageId} {
        allow read: if isClubMember(clubId);
        allow create: if isClubMember(clubId)
          && request.resource.data.authorId == request.auth.uid;
        allow update: if false;
        allow delete: if isClubAdmin(clubId) || resource.data.authorId == request.auth.uid;
      }

      /* 모임: 생성/삭제 총무. 회원은 자기 RSVP 키만 변경 가능(FIX-03 S-2) */
      /* 모임.
         회원이 고칠 수 있는 것은 자기 참석 응답뿐이다.
         rsvpBy 는 "누가 눌렀는지"이고, 서버가 이걸 보고 본인이 마음을
         바꾼 것만 운영진에게 알린다. 회원이 남의 몫으로 쓰지 못하게
         두 map 모두 자기 키만 허용한다 — rsvpBy 를 남의 이름으로
         쓸 수 있으면 알림을 조작할 수 있다. */
      match /meetings/{meetingId} {
        allow read: if isClubMember(clubId);
        allow create, delete: if isClubAdmin(clubId);
        allow update: if isClubAdmin(clubId) || (
          isClubMember(clubId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvp', 'rsvpBy']) &&
          request.resource.data.rsvp
            .diff(resource.data.get('rsvp', {})).affectedKeys().hasOnly([request.auth.uid]) &&
          request.resource.data.get('rsvpBy', {})
            .diff(resource.data.get('rsvpBy', {})).affectedKeys().hasOnly([request.auth.uid]) &&
          request.resource.data.get('rsvpBy', {}).get(request.auth.uid, request.auth.uid)
            == request.auth.uid
        );
      }

      /* 참석 투표 요청서.
         앱은 푸시 토큰을 볼 수 없으므로(회원 문서를 다 읽어야 한다)
         요청서를 한 장 남기고 서버가 대신 보낸다. 아무나 만들 수 있으면
         전체 알림을 마음대로 쏘는 통로가 되므로 운영진만 만든다.
         결과(status·sent)는 서버가 쓴다 — 앱에서는 못 고친다. */
      /* 서버에 시키는 일감. 클라이언트는 만들기만 하고 결과는 서버가 적는다.
         type 'test' 는 본인에게 테스트 알림 한 건을 보내는 것이다 —
         이 통로로 남에게 알림을 쏠 수 없게 by 가 본인이어야 한다. */
      match /pushJobs/{jobId} {
        allow read: if isClubAdmin(clubId);
        allow create: if isClubAdmin(clubId)
          && request.resource.data.by == request.auth.uid
          && request.resource.data.type in ['rsvpAsk', 'test'];
        allow update, delete: if false;
      }

      /* 게시판: 작성 멤버. 회원 수정은 댓글 추가(comments)만. 삭제는 총무 또는 작성자(FIX-03 S-3) */
      match /posts/{postId} {
        allow read: if isClubMember(clubId);
        allow create: if isClubMember(clubId) && request.resource.data.authorId == request.auth.uid;
        allow update: if isClubAdmin(clubId) || (
          isClubMember(clubId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments'])
        );
        allow delete: if isClubAdmin(clubId) || resource.data.authorId == request.auth.uid;
      }

      // 대회: 읽기 멤버, 생성·편집(스코어/대진)은 총무
      match /tournaments/{tournamentId} {
        allow read: if isClubMember(clubId);
        allow create, delete: if isClubAdmin(clubId);

        /* 참가 신청 — 회원이 자기 칸만 쓴다.

           신청자를 하위 컬렉션이 아니라 문서 안의 맵으로 둔 이유는
           src/lib/firestore.js 의 applyToTournament 주석 참고
           (일정 화면이 대회마다 "몇 자리 남음"을 그려야 한다).

           ⚠️ 여기서 막는 것
             · 남의 이름으로 신청하기 (applicants.{내 uid} 만)
             · 신청하는 척하며 정원·마감일 고치기 (건드린 키가 그것 하나여야)
             · 대진표·점수 고치기 (같은 이유)

           diff().affectedKeys() 는 최상위 키만 본다. applicants 맵 전체가
           하나의 키라서, "applicants 만 건드렸다"는 것으로는 남의 칸을
           지우는 것을 못 막는다. 그래서 내 칸 외의 신청자 목록이 그대로인지
           키 개수가 아니라 나머지 키 집합으로 확인한다. */
        allow update: if isClubAdmin(clubId)
          || (
            isClubMember(clubId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicants'])
            && request.resource.data.get('applicants', {}).keys().removeAll([request.auth.uid])
               .hasOnly(resource.data.get('applicants', {}).keys().removeAll([request.auth.uid]))
            && resource.data.get('applicants', {}).keys().removeAll([request.auth.uid])
               .hasOnly(request.resource.data.get('applicants', {}).keys().removeAll([request.auth.uid]))
          );
      }

      // 코트장(복수 운영): 읽기 멤버, 등록·수정은 운영진
      match /venues/{venueId} {
        allow read: if isClubMember(clubId);
        allow write: if isClubAdmin(clubId);
      }

      // 지출: 회장·총무 전용 (운영진·리드는 읽지도 못한다)
      match /expenses/{expenseId} {
        allow read, write: if canSeeFees(clubId);
      }

      // 원포인트 영상: 읽기 멤버 전체, 등록은 운영진
      // (용품은 앱 전체 공용이므로 루트 /gear 로 이동 — 아래 참조)
      match /tips/{tipId} {
        allow read: if isClubMember(clubId);
        allow write: if isClubAdmin(clubId);
      }

      // 회비: 회장·총무만 조회·수정
      match /fees/{monthKey} {
        allow read, write: if canSeeFees(clubId);
      }
      match /courts/{courtId} {
        allow read: if isClubMember(clubId);
        allow write: if isClubAdmin(clubId);
      }
      /* 회원 개인 납부 내역 — 본인과 회장·총무만.

         전체 명단(fees)을 회원에게 열면 누가 안 냈는지 서로 다 보게 되고,
         아예 막으면 본인도 "냈는데 미납으로 되어 있다"를 확인할 수 없다.
         그래서 본인 몫만 개인 문서로 내려 준다.

         쓰기는 회장·총무만. 단 본인은 claims(확인 요청)만 남길 수 있다 —
         자기 납부 여부를 스스로 체크하면 회비 관리가 무너진다. */
      match /memberFees/{memberId} {
        allow read: if canSeeFees(clubId)
          || (isClubMember(clubId) && request.auth.uid == memberId);
        allow write: if canSeeFees(clubId);
        // 본인의 확인 요청 — claims 외의 필드는 건드릴 수 없다
        allow create: if isClubMember(clubId)
          && request.auth.uid == memberId
          && request.resource.data.keys().hasOnly(['claims']);
        allow update: if isClubMember(clubId)
          && request.auth.uid == memberId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claims']);
      }

      /* 일회성 정산(대회·캠프·회식) — 개설·납부 체크는 회장·총무.
         참여자는 자기 몫이 얼마인지 알아야 하므로 읽기는 회원 전체에 연다.
         (정기 회비와 달리 "누가 참여하고 얼마 내는지"는 원래 공유되는 정보다) */
      match /duesPools/{poolId} {
        allow read: if isClubMember(clubId);
        allow write: if canSeeFees(clubId);
      }

      /* 회비 외 수입(게스트비·대회 등) — 결산에 들어가므로 회장·총무만 */
      match /incomes/{incomeId} {
        allow read, write: if canSeeFees(clubId);
      }

      /* meta 는 대체로 회원 공용(편성 규칙·인수인계 이력)이지만,
         회비 도구 문서는 회장·총무만 본다.
         규칙은 OR 로 평가되므로 일반 규칙에서 먼저 제외해야 실제로 막힌다. */
      match /meta/{docId} {
        allow read: if isClubMember(clubId)
          && !(docId in ['feeAliases', 'dunning']);
        allow write: if isClubAdmin(clubId)
          && !(docId in ['feeAliases', 'dunning']);
      }
      /* 입금자명 별칭 — 누가 어느 계좌로 내는지가 드러난다 */
      match /meta/feeAliases {
        allow read, write: if canSeeFees(clubId);
      }
      /* 독촉 발송 기록 — 미납 관련 정보 */
      match /meta/dunning {
        allow read, write: if canSeeFees(clubId);
      }
    }

    /* ---------- 공개 클럽 목록(루트) ----------
       클럽 검색 → 가입 신청 흐름에 필요한 최소 정보만 공개한다.
       (이름·지역·회원 수. 일정·회원 명단은 여전히 회원 전용)
       - 읽기/검색: 로그인 사용자 전체
       - 등록·수정: 해당 클럽 운영진. 클럽 생성 시점에 생성자는 이미 회장이다. */
    match /clubDirectory/{clubId} {
      allow read: if signedIn();
      /* 앱 운영자도 쓸 수 있다 — 시험 삼아 만든 클럽이나 방치된 클럽을
         검색에서 빼려면 그 클럽 안으로 들어가지 않고도 가능해야 한다.
         (클럽마다 계정을 갈아타며 끄는 것은 현실적이지 않다) */
      allow write: if isClubAdmin(clubId) || isAppAdmin();
    }

    /* 코트 정보 신고 — "링크가 안 열린다"를 이용자가 알려 준다.

       코트 목록은 한 시점에 긁어 온 값이라 조용히 틀려진다. 수백 곳을
       직접 확인할 수는 없으니 실제로 가려던 사람이 알려 주는 것이 가장
       빠르다. 앱 운영자가 모아서 보고 다음 갱신에 반영한다.

       ⚠️ 남의 신고를 읽지 못하게 한다
         신고에는 by(uid) 가 들어간다. 누가 어느 코트를 보려 했는지는
         남이 알 일이 아니다. 목록은 앱 운영자만 본다.
       ⚠️ 고치거나 지우지 못하게 한다
         신고를 낸 사람이 나중에 내용을 바꾸면 기록의 뜻이 없어진다.
         처리 표시(status)는 앱 운영자만 한다. */
    match /courtReports/{reportId} {
      allow read: if isAppAdmin();
      allow create: if signedIn()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.status == 'open';
      allow update: if isAppAdmin();
      allow delete: if false;
    }

    /* ---------- 클럽 교류전(루트) ----------
       두 클럽이 같이 보는 문서다. 클럽 하위에 두면 상대가 읽을 수 없어서
       루트에 두고, 두 클럽의 사람에게만 연다.

       권한을 한쪽에 몰아 둔 이유
         같은 대진표를 두 클럽이 동시에 고치면 마지막에 누른 쪽이 이긴다.
         그것을 합칠 방법은 없다. 실제로도 주최 클럽이 코트를 잡고 진행을
         맡으므로, 대진·결과·설정은 개설한 클럽(host)만 건드린다.
         초대받은 클럽(guest)은 수락·거절과 자기 출전 명단만 쓴다.
         상대 명단을 남이 고칠 수 있으면 교류전이 아니라 사고다. */
    match /clubMatches/{matchId} {
      function hostId() { return resource.data.hostClubId; }
      function guestId() { return resource.data.get('guestClubId', ''); }

      // 회원이면 읽을 수 있다 — 자기 클럽 경기를 선수도 봐야 한다
      allow read: if isClubMember(hostId())
        || (guestId() != '' && isClubMember(guestId()));

      // 개설은 주최 클럽 운영진이. 남의 클럽 이름으로 초대를 못 만든다.
      allow create: if isClubAdmin(request.resource.data.hostClubId)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if
        // 주최 클럽 운영진 — 두 클럽 id 는 바꿀 수 없다(상대를 몰래 갈아치우기 금지)
        (isClubAdmin(hostId())
          && request.resource.data.hostClubId == hostId()
          && request.resource.data.get('guestClubId', '') == guestId())
        // 초대받은 클럽 운영진 — 수락/거절 + 자기 명단만
        || (guestId() != '' && isClubAdmin(guestId())
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'guestRoster', 'respondedBy', 'respondedAt', 'updatedAt'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
              || request.resource.data.status == 'accepted'
              || request.resource.data.status == 'declined'));

      allow delete: if isClubAdmin(hostId());
    }

    /* ---------- 앱 운영자 명단(루트) ----------
       - 별도 로그인은 없다. 평소처럼 이메일로 로그인하고, 이 컬렉션에
         본인 uid 문서가 있으면 앱 운영자 권한이 켜진다.

       - 처음 한 명은 Firebase 콘솔에서 직접 만든다(그래야 시작할 수 있다).
         그 뒤로는 **앱 운영자가 앱 안에서** 다른 사람을 세우고 내릴 수 있다.
         콘솔에서만 가능하게 두면 인수인계가 불가능해진다 — 내가 사라지면
         아무도 용품·코치를 관리할 수 없다.

       - 스스로를 내리는 것은 막는다. 마지막 운영자가 자기를 내리면
         아무도 남지 않고, 그때는 콘솔로 들어가는 수밖에 없다. */
    match /appAdmins/{uid} {
      allow read: if signedIn();
      allow create: if isAppAdmin();
      allow update: if isAppAdmin();
      allow delete: if isAppAdmin() && request.auth.uid != uid;
    }

    /* ---------- 용품(루트, 앱 공용) ----------
       - 읽기: 로그인 사용자 전체(모든 클럽이 같은 목록을 본다)
       - 등록·수정·삭제: 앱 운영자만. 클럽 운영진도 쓸 수 없다. */
    match /gear/{gearId} {
      allow read: if signedIn();
      allow write: if isAppAdmin();
    }

    /* ---------- 코치 프로필(루트, 앱 공용) ----------

       읽기를 왜 전부 열어 두나
         회원은 승인된 코치만 봐야 하지만, 그 걸러 내기를 규칙으로 하려면
         목록 질의마다 status 조건이 붙고 색인이 늘어난다. 여기 담기는 것은
         코치가 스스로 공개하려고 적은 홍보 정보뿐이라 새어도 손해가 없다.
         화면은 coach.js 의 publicCoaches() 로 걸러 그린다.

       쓰기가 진짜 경계다
         · 문서 id = uid. 남의 프로필은 만들지도 고치지도 못한다.
         · 본인은 status 를 draft/pending 으로만 둘 수 있다.
           스스로 approved 로 올리면 심사 없이 공개되고 지급 대상이 된다.
         · reviewedBy/reviewedAt 은 본인이 영영 못 만진다.
         · approved 상태에서 내용을 고치면 pending 으로 내려간다.
           깨끗한 내용으로 승인받고 나중에 바꿔 치우는 것을 막기 위해서다.
           (돈이 걸린 광고라서 이렇게 둔다) */
    match /coaches/{coachUid} {
      function isOwner() { return request.auth.uid == coachUid; }
      function touches(fields) {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
      }
      function newStatus() { return request.resource.data.get('status', ''); }

      allow read: if signedIn();

      allow create: if isOwner()
        && newStatus() in ['draft', 'pending']
        && !request.resource.data.keys().hasAny(['reviewedBy', 'reviewedAt']);

      allow update: if isOwner()
        && !touches(['reviewedBy', 'reviewedAt'])
        && newStatus() in ['draft', 'pending'];

      allow update: if isAppAdmin();
      allow delete: if isAppAdmin() || isOwner();
    }

    /* ---------- 코치 홍보 영상(루트) ----------
       영상은 "모든 회원이 보는 광고"이고 승인이 곧 지급 결정이다.
       그래서 코치는 올리고 고치고 지울 수만 있고, 승인 상태는 앱 운영자만 바꾼다.
       프로필과 같은 이유로, 고치면 다시 pending 으로 내려간다. */
    match /coachVideos/{videoId} {
      function isMine() { return resource.data.coachId == request.auth.uid; }

      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.coachId == request.auth.uid
        && request.resource.data.get('status', '') == 'pending'
        && !request.resource.data.keys().hasAny(['reviewedBy', 'reviewedAt']);

      allow update: if isMine()
        && request.resource.data.coachId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['reviewedBy', 'reviewedAt']) == false
        && request.resource.data.get('status', '') == 'pending';

      allow update: if isAppAdmin();
      allow delete: if isAppAdmin() || isMine();
    }

    /* ---------- 코치 광고비 청구(루트) ----------
       코치가 앱에 내는 광고비 장부다. 코치 본인도 볼 수 없게 한다 —
       남이 얼마를 내는지 서로 보이면 곧바로 가격 협상거리가 된다.
       (코치에게 알릴 금액은 앱 밖에서 따로 안내한다) */
    match /coachBillings/{billingId} {
      allow read, write: if isAppAdmin();
    }

    /* ---------- 용품 주문(루트, 드랍십) ----------
       배송지와 연락처가 들어간다. 남의 주문은 보이면 안 된다. */
    match /gearOrders/{orderId} {
      allow read: if isAppAdmin() || resource.data.buyerUid == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.buyerUid == request.auth.uid
        && request.resource.data.status == 'placed';

      // 회원은 접수 상태에서만 취소할 수 있다. 그 뒤는 앱 운영자가 처리한다.
      allow update: if resource.data.buyerUid == request.auth.uid
        && resource.data.status == 'placed'
        && request.resource.data.status == 'canceled';

      allow update: if isAppAdmin();
      allow delete: if isAppAdmin();
    }

    /* ---------- 서비스 전체 현황(루트) ----------
       "클럽 N개 · 회원 M명"을 보여주기 위한 카운터. 개인 정보는 없다.
       누구나(로그인 사용자) 올릴 수 있게 두되, 값을 임의로 덮어쓰지 못하도록
       증가 연산만 허용한다. */
    match /stats/{docId} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if false;
    }

    /* ---------- 광고 노출·클릭 집계(루트) ----------
       상품별 카운터만 쌓는다. 개인 정보는 담지 않는다.
       로그인 사용자면 올릴 수 있게 두되(집계 실패가 사용자 흐름을 막으면 안 되므로),
       읽기는 앱 운영자만 — 다른 클럽이 남의 광고 성과를 볼 이유가 없다. */
    match /adStats/{adId} {
      allow read: if isAppAdmin();
      allow create, update: if signedIn();
      allow delete: if isAppAdmin();
    }

    /* ---------- 게스트 모집(루트 공개, FIX-05) ----------
       - 읽기: 로그인 사용자 전체(공개 게시판)
       - 모집글 생성/수정/삭제: 해당 클럽 총무
       - 신청(applicants/{uid}): 본인만 생성/취소, 확정(status 변경)은 모집 클럽 총무 */
    match /guestPosts/{postId} {
      function postClubId() {
        return get(/databases/$(database)/documents/guestPosts/$(postId)).data.clubId;
      }
      function isPostAdmin() { return isClubAdmin(postClubId()); }

      allow read: if signedIn();
      allow create: if signedIn() && isClubAdmin(request.resource.data.clubId);
      allow update, delete: if signedIn() && isClubAdmin(resource.data.clubId);

      match /applicants/{applicantUid} {
        allow read: if signedIn();
        allow create, delete: if request.auth.uid == applicantUid;
        allow update: if isPostAdmin();
      }
    }
  }
}
