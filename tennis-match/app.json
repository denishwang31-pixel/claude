{
  "expo": {
    "name": "테니스매치",
    "slug": "tennis-match",
    "scheme": "tennismatch",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#fafaf9",
    "primaryColor": "#064e3b",
    "android": {
      "package": "com.donghyun.tennismatch",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "INTERNET",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#022c22"
      }
    },
    "ios": {
      "bundleIdentifier": "com.donghyun.tennismatch",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#064e3b",
          "icon": "./assets/notification-icon.png"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#022c22"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ab8eb046-6344-483a-af51-c9f049a00a7e"
      }
    },
    "owner": "denis-hwang",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ab8eb046-6344-483a-af51-c9f049a00a7e"
    }
  }
}
