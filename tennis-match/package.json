    "test:labels": "node scripts/test-labels.mjs",
    "test:rsvp": "node scripts/test-rsvp.mjs",
    "test:clubmatch": "node scripts/test-clubmatch.mjs",
    "test:league": "node scripts/test-league.mjs",
    "test:scheduleview": "node scripts/test-scheduleview.mjs",
    "test:roles": "node scripts/test-rolesdraw.mjs",
    "test:coach": "node scripts/test-coach.mjs",
    "test:delete": "node scripts/test-delete.mjs",
    "test:scope": "node scripts/test-scope.mjs",
    "test:agenda": "node scripts/test-agenda.mjs",
    "test:scale": "node scripts/test-scale.mjs",
    "test:opens": "node scripts/test-opens.mjs"
