{
  "name": "tennis-match",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "doctor": "npx expo-doctor",
    "test:engine": "node scripts/test-engine.mjs",
    "test:tournament": "node scripts/test-tournament.mjs",
    "test:schedule": "node scripts/test-schedule.mjs && node scripts/test-recurrence.mjs",
    "test:rules": "firebase emulators:exec --only firestore \"node scripts/test-rules.mjs\"",
    "test:kdk": "node scripts/test-kdk.mjs",
    "test:team": "node scripts/test-team.mjs",
    "test:all": "npm run test:engine && npm run test:kdk && npm run test:team && npm run test:tournament && npm run test:schedule"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "^8.0.1",
    "@react-native-segmented-control/segmented-control": "^2.5.2",
    "expo": "~51.0.39",
    "expo-clipboard": "~6.0.3",
    "expo-constants": "~16.0.2",
    "expo-device": "~6.0.2",
    "expo-linking": "~6.3.1",
    "expo-notifications": "~0.28.19",
    "expo-router": "~3.5.24",
    "expo-status-bar": "~1.12.1",
    "expo-system-ui": "~3.0.7",
    "firebase": "^10.14.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-draggable-flatlist": "^4.0.1",
    "react-native-gesture-handler": "~2.16.2",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-webview": "13.8.6"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@firebase/rules-unit-testing": "^3.0.4"
  },
  "private": true
}
