# Database (PostgreSQL — 이 앱의 실제 DB는 Postgres입니다)
# 로컬 예: postgres://budget:budget123@localhost:5432/household_budget
# 클라우드(Neon) 예: postgres://user:pass@ep-xxx.ap-northeast-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgres://budget:budget123@localhost:5432/household_budget

# Server
PORT=3001
NODE_ENV=development
SESSION_SECRET=change-this-to-a-random-secret

# 앱/웹에서 이 서버로 접속을 허용할 출처(쉼표 구분).
# 앱(Capacitor)의 capacitor://localhost 등은 서버가 기본 허용하므로 여기엔
# 웹으로 접속하는 도메인만 넣으면 됩니다. 예: https://budget.example.com
CLIENT_ORIGINS=

# OAuth (configure your provider)
# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=http://localhost:3001/auth/kakao/callback

# Owner account (this openId gets admin role automatically)
OWNER_OPEN_ID=

# In development, you can use DEV_AUTO_LOGIN=true to skip OAuth
# ⚠️ 프로덕션(앱 출시)에서는 반드시 false — true면 아무나 자동 로그인됩니다.
DEV_AUTO_LOGIN=true
