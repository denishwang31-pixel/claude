# Database
DATABASE_URL=mysql://user:password@localhost:3306/household_budget

# Server
PORT=3001
NODE_ENV=development
SESSION_SECRET=change-this-to-a-random-secret

# OAuth (configure your provider)
# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=http://localhost:3001/auth/kakao/callback

# Owner account (this openId gets admin role automatically)
OWNER_OPEN_ID=

# In development, you can use DEV_AUTO_LOGIN=true to skip OAuth
DEV_AUTO_LOGIN=true
